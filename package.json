{
  "name": "dsh-bayern-home",
  "version": "0.5.2",
  "description": "拜仁主场：DSH 深浅主题、赛程比分、真实球员名片与可编辑战术板。",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "NOTICE.md",
    "LICENSE",
    "INSTALL.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test scripts/data.test.mjs scripts/studio.test.mjs",
    "pack": "npm pack --pack-destination dist --ignore-scripts",
    "preview": "node scripts/serve.cjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Li-junning/plugin-dsh-2.git"
  },
  "homepage": "https://github.com/Li-junning/plugin-dsh-2#readme",
  "bugs": {
    "url": "https://github.com/Li-junning/plugin-dsh-2/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "bayern",
    "football",
    "theme"
  ],
  "engines": {
    "node": ">=20"
  }
}
